# Copy to .env.local and replace targets for your development environment.
# See docs/local-integration.md for the existing remote integration environment.
# These defaults require backend services running on this computer.
DEV_API_TARGET=http://127.0.0.1:8080
DEV_LABELING_TARGET=http://127.0.0.1:8082
LABEL_PROXY_TARGET=http://127.0.0.1:8013
DEV_MLFLOW_TARGET=http://127.0.0.1:5000
DEV_MLFLOW_THROUGH_GATEWAY=false
