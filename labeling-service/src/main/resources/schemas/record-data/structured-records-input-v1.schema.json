{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tss:structured-records-input@1.0.0",
  "type": "object",
  "required": [
    "sampleId",
    "inputHash",
    "inputFormat",
    "schemaId",
    "sourcePath",
    "sourceRow",
    "record"
  ],
  "properties": {
    "sampleId": {
      "type": "string",
      "format": "uuid"
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputFormat": {
      "const": "structured-records-input-v1"
    },
    "schemaId": {
      "const": "structured-records-input@1.0.0"
    },
    "sourcePath": {
      "type": "string"
    },
    "sourceRow": {
      "type": "integer",
      "minimum": 1
    },
    "record": {
      "type": "object"
    },
    "raw": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
