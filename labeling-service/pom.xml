<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 沿用训练后端的版本，由 Spring Boot 统一管理依赖版本。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.tss.labeling</groupId>
    <artifactId>tss-labeling-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>tss-labeling-service</name>
    <description>数据标注业务服务</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.28.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.2.2</version>
            <scope>test</scope>
        </dependency>
        <!-- 提供 HTTP 服务、接口路由和 JSON 序列化。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 提供连接池和 JDBC 数据库访问能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway 负责版本化建表，PostgreSQL 支持使用独立模块。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes><exclude>static/editor-assets/**</exclude></excludes>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-editor-resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>prepare-fixed-editor-resources</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <property file="${project.basedir}/third-party/label-studio/editor-assets-1.23.2.properties"/>
                                <checksum file="${project.basedir}/third-party/label-studio/editor-assets-1.23.2.zip"
                                          algorithm="SHA-256" property="editor.actual.sha256"/>
                                <fail message="Editor bundle SHA-256 mismatch; do not deploy unreviewed assets.">
                                    <condition><not><equals arg1="${editor.actual.sha256}" arg2="${editor.bundle.sha256}"/></not></condition>
                                </fail>
                                <delete dir="${project.build.directory}/generated-editor-resources"/>
                                <delete dir="${project.build.outputDirectory}/static/editor-assets"/>
                                <mkdir dir="${project.build.directory}/generated-editor-resources/static/editor-assets"/>
                                <unzip src="${project.basedir}/third-party/label-studio/editor-assets-1.23.2.zip"
                                       dest="${project.build.directory}/generated-editor-resources/static/editor-assets"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
